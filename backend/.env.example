PORT=3000
MONGODB_URI=mongodb://localhost:27017/merz
# For MongoDB Atlas, use the mongodb+srv:// connection string instead.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FEEDBACK_EDIT_DAYS=7
SALON_TIMEZONE=Asia/Manila
SALON_MIN_NOTICE_HOURS=2
APPOINTMENT_CONFIRMATION_GRACE_MINUTES=15
RECAPTCHA_SECRET_KEY=
# Required in production by default. Set false for local development if needed.
RECAPTCHA_REQUIRED=false
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/admin/calendar/callback
# Used to encrypt integration credentials stored in MongoDB. Generate a long random value.
SETTINGS_ENCRYPTION_KEY=
